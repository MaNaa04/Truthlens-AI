# Environment configuration
# Copy this file to .env and fill in your actual values

# ── Application Settings ──────────────────────────────────────────────────────
APP_DEBUG=false

# ── Server Configuration ──────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── LLM Configuration ─────────────────────────────────────────────────────────
# Active provider: groq (free, fast — recommended)
# Other options: gemini, openai, anthropic, grok
LLM_PROVIDER=groq
LLM_API_KEY=your_groq_api_key_here
LLM_MODEL=llama-3.3-70b-versatile

# Provider-specific examples:
# Groq (FREE):     LLM_PROVIDER=groq, LLM_MODEL=llama-3.3-70b-versatile   → get key at console.groq.com
# Gemini (FREE):   LLM_PROVIDER=gemini, LLM_MODEL=gemini-2.0-flash         → get key at aistudio.google.com
# OpenAI (PAID):   LLM_PROVIDER=openai, LLM_MODEL=gpt-4o-mini              → get key at platform.openai.com
# Anthropic (PAID):LLM_PROVIDER=anthropic, LLM_MODEL=claude-3-5-haiku-20241022

# ── External APIs ─────────────────────────────────────────────────────────────
SERPAPI_KEY=your_serpapi_key_here
WIKIPEDIA_API_ENABLED=true

# ── Caching ───────────────────────────────────────────────────────────────────
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600

# ── Redis (Upstash — cloud) ───────────────────────────────────────────────────
# Get your free Redis at: https://upstash.com/
# Format: rediss://default:<password>@<endpoint>.upstash.io:6379
REDIS_URL=rediss://default:your_password@your-endpoint.upstash.io:6379
REDIS_ENABLED=true

# ── CORS ──────────────────────────────────────────────────────────────────────
# Lock down to your Chrome Extension ID in production:
# ALLOWED_ORIGINS=["chrome-extension://your_extension_id_here"]
# Use ["*"] only for local development
ALLOWED_ORIGINS=["*"]

# ── Evidence Configuration ────────────────────────────────────────────────────
MAX_EVIDENCE_TOKENS=800
MAX_CLAIMS_PER_REQUEST=3

# ── JWT Authentication ────────────────────────────────────────────────────────
# Generate a strong random secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your_random_jwt_secret_here
JWT_ALGORITHM=HS256
JWT_EXPIRY_SECONDS=3600

# ── MongoDB Atlas (per-user history) ─────────────────────────────────────────
# Get your free Atlas cluster at: https://www.mongodb.com/atlas/database
# Format: mongodb+srv://<user>:<password>@cluster0.xyz.mongodb.net/?appName=Cluster0
# Local dev only: mongodb://localhost:27017
MONGODB_URL=mongodb+srv://your_user:your_password@cluster0.xyz.mongodb.net/?appName=Cluster0
DATABASE_NAME=aimatrix_db
