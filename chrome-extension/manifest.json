{
  "manifest_version": 3,
  "name": "TruthLens",
  "version": "1.1",
  "description": "Verify AI-generated text and detect hallucinations on any page.",
  "permissions": [
    "contextMenus",
    "activeTab",
    "scripting",
    "identity",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "https://www.googleapis.com/*",
    "https://oauth2.googleapis.com/*",
    "https://accounts.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon.svg",
      "48": "icons/icon.svg",
      "128": "icons/icon.svg"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ]
    },
    {
      "matches": [
        "*://chatgpt.com/*",
        "*://chat.openai.com/*",
        "*://claude.ai/*",
        "*://gemini.google.com/*",
        "*://perplexity.ai/*"
      ],
      "js": [
        "ai-chat-injector.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}